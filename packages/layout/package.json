{
  "name": "@vuepdf/layout",
  "version": "1.0.0",
  "description": "Layout engine for vue-pdf using yoga-layout",
  "license": "MIT",
  "author": "Boluwatife Adewale",
  "homepage": "https://github.com/Boluwatife2904/vue-pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boluwatife2904/vue-pdf.git",
    "directory": "packages/layout"
  },
  "bugs": {
    "url": "https://github.com/Boluwatife2904/vue-pdf/issues"
  },
  "keywords": [
    "vue",
    "pdf",
    "vue-pdf"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
