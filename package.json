{
  "name": "vue-pdf",
  "private": true,
  "description": "Create PDF files using Vue - Vue renderer for creating PDF files on the browser and server",
  "type": "module",
  "packageManager": "pnpm@9.15.1",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "nuxi dev docs",
    "docs:llms": "node docs/scripts/generate-llms.mjs",
    "docs:favicon": "node docs/scripts/generate-favicon.mjs",
    "docs:build": "pnpm run docs:llms && NODE_OPTIONS=--max-old-space-size=8192 nuxi build docs",
    "docs:generate": "pnpm run docs:llms && NODE_OPTIONS=--max-old-space-size=8192 nuxi generate docs",
    "test": "vitest",
    "lint": "eslint packages --ext .ts,.vue",
    "typecheck": "vue-tsc --noEmit",
    "clean": "pnpm -r run clean",
    "release:patch": "pnpm -r --filter \"./packages/**\" exec pnpm version patch --no-git-tag-version",
    "release:minor": "pnpm -r --filter \"./packages/**\" exec pnpm version minor --no-git-tag-version",
    "release:major": "pnpm -r --filter \"./packages/**\" exec pnpm version major --no-git-tag-version",
    "publish:packages": "pnpm run build && pnpm -r --filter \"./packages/**\" publish --access public --no-git-checks"
  },
  "dependencies": {
    "@vuepdf/nuxt": "workspace:*",
    "@vuepdf/renderer": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^1.6.0",
    "@types/node": "^20.14.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.0.0",
    "highlight.js": "^11.11.1",
    "jest-image-snapshot": "^6.5.2",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.55.1",
    "nuxt": "^3.12.0",
    "nuxt-og-image": "^6.5.1",
    "pdfjs-dist": "^6.1.200",
    "prettier": "^3.3.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "unbuild": "^3.6.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^2.0.0",
    "vitest-fetch-mock": "^0.2.2",
    "vue": "^3.5.40",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
