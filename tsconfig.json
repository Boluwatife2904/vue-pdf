{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@vuepdf/renderer/components": ["./packages/renderer/src/components/index.d.ts"],
      "@vuepdf/renderer/primitives": ["./packages/renderer/src/primitives.d.ts"],
      "@vuepdf/*": ["./packages/*/src"]
    }
  },
  "exclude": ["node_modules", "dist", "**/tests"]
}
